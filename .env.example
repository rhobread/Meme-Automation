# Replace placeholders locally. Never share or commit .env.
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password
INTERNAL_API_KEY=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ENABLE_AUTOPUBLISH=false
# Enabling this allows manually approved publishing too. Keep false until ready.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_API_VERSION=v26.0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Pre-create a PRIVATE bucket; upload verifies it is not public.
SUPABASE_BUCKET=originals
PUBLISHING_QUOTA_CAP=25
