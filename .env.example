# Replace placeholders locally. Never share or commit .env.
POSTGRES_PASSWORD=replace-with-random-alphanumeric-password
INTERNAL_API_KEY=replace-with-at-least-32-random-characters
TOKEN_ENCRYPTION_KEY=replace-with-generated-fernet-key
N8N_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
ENABLE_AUTOPUBLISH=false
# Keep false: ChatGPT Plus does not cover OpenAI API charges.
# Paid services are not authorized for this project.
ALLOW_PAID_SERVICES=false
AI_PROVIDER=ollama
# Install Ollama locally, disable cloud, then choose/pull a licensed local model yourself.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=60
STORAGE_PROVIDER=local
LOCAL_MEDIA_DIR=./media
# Existing operator-provided HTTPS origin; do not expose other internal API routes.
MEDIA_PUBLIC_BASE_URL=
# Operator-permitted ideas-only RSS feeds as a JSON array.
DISCOVERY_FEEDS=[]
ENABLE_AUTOAPPROVAL=false
# Enabling this allows manually approved publishing too. Keep false until ready.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_API_VERSION=v26.0
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Pre-create a PRIVATE bucket; upload verifies it is not public.
SUPABASE_BUCKET=originals
PUBLISHING_QUOTA_CAP=25
